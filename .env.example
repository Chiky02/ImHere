SESSION_SECRET=cambia-esta-clave-larga
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Producción en Vercel: crea un proyecto en supabase.com, corre
# supabase/migrations/001_init.sql y opcionalmente seed.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Audio de alerta del panel (opcional). Por defecto: /sounds/alerta.wav
# Puedes poner tu MP3 en public/sounds/alerta.mp3 y usar:
# NEXT_PUBLIC_ALERT_SOUND_URL=/sounds/alerta.mp3
# o una URL absoluta https://...
NEXT_PUBLIC_ALERT_SOUND_URL=
